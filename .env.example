# Copie este arquivo para .env e preencha os valores.
# O arquivo .env não deve ser versionado.

# Fase 2 - Chave da API OpenWeather (previsão de chuva)
OPENWEATHER_API_KEY=

# Banco SQLite compartilhado (opcional)
# Se não for definido, o sistema usa data/agro_sensors.db na raiz do repositório.
AGRO_DB_PATH=

# Fase 4 - Porta serial dos sensores (opcional)
# Padrão: simulador Wokwi em rfc2217://localhost:4000.
# Para um ESP32 físico, informe a porta (ex.: /dev/cu.usbserial-0001).
SENSOR_SERIAL_PORT=

# Certificados SSL (opcional)
# Use quando a rede, VPN ou antivírus inspecionar o tráfego HTTPS
# e as chamadas à API falharem com CERTIFICATE_VERIFY_FAILED.
# Aponte para um arquivo .pem com os certificados confiáveis do sistema.
SSL_CERT_FILE=
